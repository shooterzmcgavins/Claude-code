# AI Engineering Workspace — Environment Configuration

# Provider: ollama (default) or anthropic
PROVIDER=ollama

# Ollama settings (used when PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Anthropic (only required if PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Workspace directory
WORKSPACE=workspace
