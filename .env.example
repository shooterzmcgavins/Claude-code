# Provider: "anthropic" (default) or "ollama"
PROVIDER=anthropic

# Anthropic — required when PROVIDER=anthropic
ANTHROPIC_API_KEY=your_api_key_here

# Ollama — required when PROVIDER=ollama
# Run: ollama serve   (starts the local server)
# Run: ollama pull llama3.2   (or qwen2.5, mistral-nemo, etc.)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Platform tokens — only set the ones you're using
SLACK_BOT_TOKEN=
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
